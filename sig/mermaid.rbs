module Mermaid
  VERSION: String

  module ToMermaid
    def to_mermaid: () -> String
  end

  class Renderer
    SAFE: Regexp
    PLACEHOLDERS: Regexp
    PLAIN: Regexp

    def self.render: (Diagrams::Base diagram) -> String
    def self.registry: () -> Hash[Class, singleton(Renderer)]

    def initialize: (Diagrams::Base diagram) -> void
    def render: () -> String
  end

  module InlineTitle
  end

  module Renderers
    class FlowchartRenderer < Renderer
      RESERVED: Array[String]
    end

    class StateRenderer < Renderer
      RESERVED: Array[String]
    end

    class ClassRenderer < Renderer
      ARROWS: Hash[Symbol, String]
      RESERVED: Array[String]
      OPERATION: Regexp
    end

    class ERRenderer < Renderer
      LEFT: Hash[Symbol, String]
      RIGHT: Hash[Symbol, String]
      WORD: Regexp
    end

    class PieRenderer < Renderer
    end

    class GanttRenderer < Renderer
      KEYWORDS: Array[String]
    end

    class TimelineRenderer < Renderer
      KEYWORDS: Array[String]
    end

    class GitgraphRenderer < Renderer
    end
  end
end

module Diagrams
  class Base
    include Mermaid::ToMermaid
  end
end
